rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny by default. Every collection below opens exactly what a story needs,
    // and no more. Anything without a match block is unreachable.

    match /users/{uid} {
      allow read, write: if false;
    }

    match /types/{typeId} {
      allow read, write: if false;
    }

    match /equipment/{equipmentId} {
      allow read, write: if false;
    }

    match /bookings/{bookingId} {
      allow read, write: if false;
    }

    // Slot occupancy. Existence means taken. Created only, never modified or
    // deleted, which is what makes the create atomic. See decisions.md.
    match /slots/{slotId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Catch-all. Any collection not named above is denied outright.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}