rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isManager() {
      return request.auth != null && request.auth.token.role == 'manager';
    }

    function changedKeysAre(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

      match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }

      match /types/{typeId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /equipment/{equipmentId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /bookings/{bookingId} {
      allow read: if isManager()
        || (request.auth != null && resource.data.trainerId == request.auth.uid);

      allow update: if isManager()
        && changedKeysAre(['status'])
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'refused'];

      allow create, delete: if false;
    }

    // Slot occupancy. Existence means taken. Created only, never modified or
    // deleted, which is what makes the create atomic. See decisions.md.
    match /slots/{slotId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if false;
       allow delete: if isManager();
    }

    // Catch-all. Any collection not named above is denied outright.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}