{
  "name": "equipment-booking",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:emulator": "firebase emulators:exec --only firestore,auth,storage \"vitest run\"",
    "test:e2e": "firebase emulators:exec --only firestore,auth \"node scripts/seed.mjs && playwright test\"",
    "test:e2e:ui": "firebase emulators:exec --only firestore,auth \"node scripts/seed.mjs && playwright test --ui\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "firebase": "12.17.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@playwright/test": "1.62.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "firebase-admin": "14.2.0",
    "firebase-tools": "15.25.1",
    "postcss": "^8.5.6",
    "prettier": "3.9.6",
    "tailwindcss": "^3.4.19",
    "vitest": "4.1.10"
  }
}
